{
  "$schema": "https://tinyjs.app/schema/tinyjs.schema.json",
  "name": "tiny-tally",
  "title": "Tiny Tally",
  "size": "1180x780",
  "id": "com.tarwin.tiny-tally",
  "version": "0.6.0",
  "backend": "backend/main.ts",
  "frontend": {
    "build": "pnpm run build",
    "dist": "dist",
    "dev": "node node_modules/vite/bin/vite.js --host 127.0.0.1 --port 5173 --strictPort",
    "devUrl": "http://127.0.0.1:5173"
  },
  "fileExtensions": [
    "tally"
  ],
  "update": {
    "url": "https://github.com/tarwin/tiny-tally/releases/latest/download/manifest.json",
    "auto": "daily"
  },
  "macos": {
    "chrome": {
      "frame": false,
      "windowControlsPos": {
        "x": 14,
        "y": 14
      }
    }
  }
}
